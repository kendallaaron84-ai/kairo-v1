POSTGRES_DB=kairo
POSTGRES_USER=kairo_admin
POSTGRES_PASSWORD=replace-with-local-admin-password
KAIRO_RUNTIME_USER=kairo_runtime
KAIRO_RUNTIME_PASSWORD=replace-with-local-runtime-password
KAIRO_DATABASE_URL=postgresql+psycopg://kairo_admin:replace-with-local-admin-password@kairo-postgres:5432/kairo
KAIRO_RUNTIME_DATABASE_URL=postgresql+psycopg://kairo_runtime:replace-with-local-runtime-password@kairo-postgres:5432/kairo
KAIRO_API_BASE_URL=http://kairo-command-api:8080
KAIRO_ARTIFACT_GCS_BUCKET=replace-with-canonical-artifact-bucket
KAIRO_QUALIFICATION_MANIFEST_GCS_URI=gs://replace-with-canonical-artifact-bucket/manifests/theta_q1_2024_manifest.json
KAIRO_CAPITAL_API_TOKEN=replace-with-api-only-internal-token
