FROM node:22.13-alpine AS dependencies

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM dependencies AS build

COPY . .
RUN npm run build

FROM node:22.13-alpine AS runtime

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8080
WORKDIR /app

RUN addgroup -S kairo && adduser -S -G kairo kairo
COPY --from=build --chown=kairo:kairo /app/dist/standalone ./

USER kairo
EXPOSE 8080
CMD ["node", "server.js"]
